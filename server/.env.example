# Copy this file to .env and replace every <placeholder>. Never commit .env.

# ── Database ──────────────────────────────────────────────────────────────
# Supabase dashboard → Connect → ORMs → Prisma (copy the exact strings shown there).
# URL-encode special characters in the password (e.g. @ → %40, # → %23).
# Transaction pooler, port 6543: used by the running server and the seed (src/lib/prisma.ts)
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler / direct connection, port 5432: used by Prisma Migrate (prisma.config.ts)
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Supabase Storage ──────────────────────────────────────────────────────
# Project URL: Settings → Data API (without /rest/v1/).
# Key: Settings → API Keys → secret key (sb_secret_...) or the legacy service_role key.
# Server-side only: never put this key in the client app.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<secret-key>"
SUPABASE_BUCKET="uploads"

# ── Auth ──────────────────────────────────────────────────────────────────
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="<random-secret>"
JWT_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────────────────────────────
# Browser origin(s) allowed by CORS; comma-separate several (e.g. local + deployed client)
CLIENT_URL="http://localhost:5173"
PORT=3000
